# Copia este archivo como .env y completa con los datos de tu proyecto Supabase.
# Todo lo que empieza con VITE_ es PÚBLICO (va dentro de la web). Nunca pongas aquí la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
VITE_VAPID_PUBLIC_KEY=clave-publica-vapid
